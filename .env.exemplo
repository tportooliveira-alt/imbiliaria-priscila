# Renomeie para .env (NÃO commite o .env real)
# Pegue suas chaves em:
#   Google AI Studio: https://aistudio.google.com/apikey  (grátis, 1.500 req/dia)
#   Anthropic:        https://console.anthropic.com       (US$ 10 de crédito inicial)

GOOGLE_API_KEY=
ANTHROPIC_API_KEY=

# JWT — gere com:  python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=

# Bootstrap admin (criado no primeiro boot se a tabela 'usuarios' estiver vazia)
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_SENHA=

# DEV ONLY — aceita qualquer login. NÃO deixar em produção.
# DEV_OPEN_ADMIN=1

# WhatsApp via Evolution API self-hosted (W2)
# Documentação: https://doc.evolution-api.com/
# Sem essas variáveis, o backend cai em fallback e a UI usa wa.me do navegador.
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCIA=priscila

# Meta / Instagram Graph API (deixar vazio ate configurar no cofre/VPS)
# Nunca commitar token real. Publicacao pelo MCP fica desligada por padrao.
META_APP_ID=
META_APP_SECRET=
META_PAGE_ID=
META_PAGE_TOKEN=
IG_BUSINESS_ACCOUNT_ID=
META_GRAPH_VERSION=
MCP_IG_PUBLISH_ENABLED=0
META_AUTO_OUTREACH=0

# Meta Ads / Lead Ads (somente leitura/rascunho pausado ate aprovacao)
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_INSTAGRAM_ACTOR_ID=
META_PIXEL_ID=1955519091819408
META_VERIFY_TOKEN=

# Google Ads API (primeiro somente leitura de resultados)
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_CUSTOMER_ID=

# Agente 24/7 no VPS (lembretes de agenda)
AGENTE_LEMBRETES_INTERVALO_SEGUNDOS=900
AGENTE_LEMBRETES_JANELA_HORAS=24
AGENTE_LOG_LEVEL=INFO

# W6 — Watermark automatico nas fotos publicas (1=ativo default, 0=desativa)
WATERMARK_ATIVO=1
# WATERMARK_TEXTO=Priscila Vasconcelos · CRECI/BA 29.231

# Producao (W8)
# CORS_ORIGINS=https://vasconcelosimoveis.com.br
# SITE_DB_PATH=/var/www/imobiliaria/data/site.db
# DOCS_DIR=/var/www/imobiliaria/data/docs
