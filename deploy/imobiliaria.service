[Unit]
Description=Imobiliaria Priscila Vasconcelos (FastAPI + uvicorn)
After=network.target

[Service]
Type=simple
User=priscila
Group=priscila
WorkingDirectory=/var/www/imobiliaria
EnvironmentFile=/var/www/imobiliaria/.env
ExecStart=/var/www/imobiliaria/venv/bin/uvicorn server:app \
  --host 127.0.0.1 \
  --port 8001 \
  --workers 2 \
  --proxy-headers \
  --forwarded-allow-ips="127.0.0.1"
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

# Hardening basico
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/var/www/imobiliaria/data /var/www/imobiliaria/logs

[Install]
WantedBy=multi-user.target
