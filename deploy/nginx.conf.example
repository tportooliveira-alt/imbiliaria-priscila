# Nginx — reverse proxy para FastAPI + servir estaticos
# /etc/nginx/sites-available/imobiliaria

server {
    listen 80;
    server_name vasconcelosimoveis.com.br www.vasconcelosimoveis.com.br;

    # Limite de upload (fotos ate 12MB)
    client_max_body_size 15M;

    # Compressao
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript image/svg+xml;
    gzip_min_length 1024;

    # Cache estatico longo (imagens processadas)
    location /assets/imoveis/ {
        alias /var/www/imobiliaria/assets/imoveis/;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    location /assets/ {
        alias /var/www/imobiliaria/assets/;
        expires 7d;
    }

    location /shared/ {
        alias /var/www/imobiliaria/shared/;
        expires 1d;
    }

    location /admin/ {
        alias /var/www/imobiliaria/admin/;
        expires 1h;
    }

    # API + paginas dinamicas → uvicorn
    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 60s;
    }

    # Headers de seguranca
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;

    # Bloqueia acesso direto a arquivos sensiveis
    location ~ /\. { deny all; }
    location ~ \.(db|env|log|py)$ { deny all; }
}
